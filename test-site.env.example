# Settings for start-test-site.bat (the test site on this computer, see TEST-SITE.md).
# start-test-site.bat copies this file to test-site.env the first time.
# test-site.env stays on your computer: it is never uploaded to GitHub.

# The password testers type before they can see the site. Required.
SITE_PASSWORD=

# PDF translations: 1 = free test mode (placeholder text, Claude is not called)
#                   0 = real translations with Claude (uses ANTHROPIC_API_KEY in
#                       pdf-translator/.env and is charged to that key)
TRANSLATOR_TEST_MODE=1

# false = new accounts can log in straight away (no verification email)
REQUIRE_EMAIL_VERIFICATION=false
