# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-this-with-a-long-random-string

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=onboarding@resend.dev
# Set to false to skip email verification (new accounts can log in straight away)
REQUIRE_EMAIL_VERIFICATION=true

# PDF translator (pdf-translator/server.py) — used by the Documents page
TRANSLATOR_URL=http://127.0.0.1:5000
# Must be the same as TRANSLATOR_SECRET in pdf-translator/.env
TRANSLATOR_SECRET=replace-this-with-the-same-random-string-as-the-translator
# How many PDF translations each user may start per 24 hours
TRANSLATIONS_PER_DAY=5

# Chat translation (Azure AI Translator) — from the Translator resource's
# "Keys and Endpoint" page in the Azure portal. Leave the key empty for test mode.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=japaneast

# --- Used on Render; leave empty on your computer ---
# Folder for junction.db and uploads/ (empty = the backend folder)
DATA_DIR=
# Password visitors must type before seeing the site (empty = no password)
SITE_PASSWORD=
