# Copy this file to .env and fill in the values. .env is never uploaded to GitHub.

# Your Claude API key (from console.anthropic.com).
# Not needed for the free test mode: python server.py --test
ANTHROPIC_API_KEY=

# Shared password between this translator and the website's back end.
# The website's backend/.env must have the SAME value as TRANSLATOR_SECRET.
TRANSLATOR_SECRET=

TRANSLATOR_PORT=5000
# Longest PDF the website may send, in pages.
MAX_PAGES=20
